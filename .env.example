PORT=8787
# Leave unset on this machine. A hosted trial sets 0.0.0.0 so the platform can reach the process.
# HOST=0.0.0.0
DATABASE_PATH=./data/fitcalorie.sqlite
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 only behind a TLS-terminating proxy, so sign-in limits use the visitor's address.
# TRUST_PROXY=1

# Optional. Used only when a product page has no nutrition table.
# The key stays on the server and is never sent to the browser.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
